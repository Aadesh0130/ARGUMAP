      "source_license": "UNVERIFIED",
      "turn_id": "turn_001",
      "turn_index": 0,
      "speaker_id": "spk_001",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_002",
      "unit_text": "The candidates need no introduction.",
      "char_start": 14,
      "char_end": 50,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Moderator introductory phrase",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_001",
      "turn_index": 0,
      "speaker_id": "spk_001",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_003",
      "unit_text": "The question before the American people tonight is whether our nation is moving ahead with sufficient vigor, or whether our national growth has slowed dangerously under current policies.",
      "char_start": 51,
      "char_end": 237,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Topic framing question",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_001",
      "turn_index": 0,
      "speaker_id": "spk_001",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_004",
      "unit_text": "Senator Kennedy, you have eight minutes for your opening presentation.",
      "char_start": 238,
      "char_end": 308,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Floor handoff",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_005",
      "unit_text": "Mr. Smith, Governor Nixon.",
      "char_start": 0,
      "char_end": 26,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Salutations",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_006",
      "unit_text": "In the election of 1860, Abraham Lincoln asked whether this nation could exist half slave and half free.",
      "char_start": 27,
      "char_end": 131,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 0.9,
      "note": "Historical rhetorical allusion",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_007",
      "unit_text": "The question facing the United States tonight is whether our society can maintain freedom in competition with a relentless totalitarian adversary.",
      "char_start": 132,
      "char_end": 278,
      "component_label": "CLAIM",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Central thesis: maintaining freedom in competition",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_008",
      "unit_text": "Our domestic economy has slowed to an anemic annual growth rate of barely two percent over the past seven years, while Soviet industrial production is expanding at over seven percent each year.",
      "char_start": 279,
      "char_end": 472,
      "component_label": "EVIDENCE",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Economic comparison statistics: 2% US vs 7% Soviet",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_009",
      "unit_text": "Today, American steel mills are operating at only fifty percent of productive capacity, thirty-five million Americans live below the poverty threshold",
      "char_start": 473,
      "char_end": 623,
      "component_label": "EVIDENCE",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Capacity and poverty statistics: 50% steel, 35M in poverty",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_010",
      "unit_text": "thousands of public classrooms remain dangerously overcrowded because the federal government has abdicated its fundamental responsibility to invest in national strength.",
      "char_start": 629,
      "char_end": 798,
      "component_label": "EVIDENCE",
      "annotator_id": "annotator_A",
      "confidence": 0.9,
      "note": "Classroom overcrowding factual conditions",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_002",
      "turn_index": 1,
      "speaker_id": "spk_002",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_011",
      "unit_text": "We cannot maintain world leadership abroad if we allow our domestic foundation to deteriorate at home.",
      "char_start": 799,
      "char_end": 901,
      "component_label": "CLAIM",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Conclusion: domestic strength required for world leadership",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_012",
      "unit_text": "Mr. Smith, Senator Kennedy.",
      "char_start": 0,
      "char_end": 27,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Salutations",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_013",
      "unit_text": "The goals that Senator Kennedy has stated for America are goals that every patriotic citizen shares.",
      "char_start": 28,
      "char_end": 128,
      "component_label": "OTHER",
      "annotator_id": "annotator_A",
      "confidence": 0.9,
      "note": "Patriotic consensus concession",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_014",
      "unit_text": "Where we disagree fundamentally is on the method by which those goals must be reached.",
      "char_start": 129,
      "char_end": 215,
      "component_label": "CLAIM",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Nixon primary thesis: disagreement on method",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_015",
      "unit_text": "When Senator Kennedy asserts that our economy has stood still, he ignores the extraordinary record of private enterprise over the past eight years.",
      "char_start": 216,
      "char_end": 363,
      "component_label": "COUNTERARGUMENT",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Direct objection: Kennedy ignores private enterprise record",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_016",
      "unit_text": "During this administration, we have built more schools and hospitals than in any comparable period in American history",
      "char_start": 364,
      "char_end": 482,
      "component_label": "EVIDENCE",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "School and hospital construction record citation",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_017",
      "unit_text": "real wages have increased by nineteen percent compared to only two percent in the previous seven years.",
      "char_start": 488,
      "char_end": 591,
      "component_label": "EVIDENCE",
      "annotator_id": "annotator_A",
      "confidence": 1.0,
      "note": "Real wage statistics: 19% vs 2%",
      "guideline_version": "1.0.0"
    },
    {
      "debate_id": "debate_003_kennedy_nixon",
      "source_corpus": "kennedy_nixon_1960",
      "source_license": "UNVERIFIED",
      "turn_id": "turn_003",
      "turn_index": 2,
      "speaker_id": "spk_003",
      "speaker_role": "Debater",
      "speaker_side": "Neutral",
      "unit_id": "u_018",
      "unit_text": "The way to national strength is not to maximize the power of federal bureaucracy in Washington, but to unleash the creative energy of one hundred and eighty million free individual Americans.",
      "char_start": 592,
      "char_end": 783,
      "component_label": "REBUTTAL",
      "annotator_id": "annotator_A",
      "confidence": 0.95,
      "note": "Defense rejecting federal bureaucracy for free enterprise",
      "guideline_version": "1.0.0"
    }
