{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://argumap.org/schemas/annotation.schema.json",
  "title": "ARGUMAP Annotation Document Schema",
  "description": "JSON Schema specification for validating ARGUMAP human annotation files and gold debate corpora.",
  "type": "object",
  "required": [
    "debate_id",
    "title",
    "source_corpus",
    "source_license",
    "guideline_version",
    "units",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "debate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique debate session identifier."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Debate title or topic resolution."
    },
    "source_corpus": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the source corpus matching data/dataset_manifest.json."
    },
    "source_license": {
      "type": "string",
      "minLength": 1,
      "description": "License applicable to the source material."
    },
    "guideline_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of ANNOTATION_GUIDELINES.md."
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of creation."
    },
    "annotator_id": {
      "type": "string",
      "description": "Identifier of assigned annotator."
    },
    "status": {
      "type": "string",
      "description": "Lifecycle status of the annotation document."
    },
    "attribution": {
      "type": "string",
      "description": "Attribution or licensing notice."
    },
    "candidate_relation_policy": {
      "type": ["string", "object"],
      "description": "Candidate-pair generation window policy."
    },
    "pilot_selection": {
      "type": "object",
      "description": "Metadata regarding the bounded pilot subset selection."
    },
    "instructions": {
      "type": "object",
      "description": "Annotator instructions and ambiguity logging protocol."
    },
    "units": {
      "type": "array",
      "description": "List of segmented argument units / propositions.",
      "items": {
        "type": "object",
        "required": [
          "debate_id",
          "source_corpus",
          "source_license",
          "turn_id",
          "turn_index",
          "speaker_id",
          "unit_id",
          "unit_text",
          "char_start",
          "char_end",
          "component_label",
          "annotator_id",
          "confidence",
          "guideline_version"
        ],
        "additionalProperties": false,
        "properties": {
          "debate_id": { "type": "string", "minLength": 1 },
          "source_corpus": { "type": "string", "minLength": 1 },
          "source_license": { "type": "string", "minLength": 1 },
          "turn_id": { "type": "string", "minLength": 1 },
          "turn_index": { "type": "integer", "minimum": 0 },
          "speaker_id": { "type": "string", "minLength": 1 },
          "speaker_role": { "type": "string" },
          "speaker_side": { "type": "string" },
          "unit_id": { "type": "string", "minLength": 1 },
          "unit_text": { "type": "string", "minLength": 1 },
          "char_start": { "type": "integer", "minimum": 0 },
          "char_end": { "type": "integer", "minimum": 1 },
          "component_label": {
            "type": "string",
            "enum": [
              "CLAIM",
              "PREMISE",
              "EVIDENCE",
              "COUNTERARGUMENT",
              "REBUTTAL",
              "OTHER"
            ]
          },
          "annotator_id": { "type": "string", "minLength": 1 },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "note": { "type": "string" },
          "guideline_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relations": {
      "type": "array",
      "description": "List of directed relations connecting argument units.",
      "items": {
        "type": "object",
        "required": [
          "source_unit_id",
          "target_unit_id",
          "relation_label",
          "same_speaker",
          "cross_turn",
          "turn_distance",
          "annotator_id",
          "confidence",
          "guideline_version"
        ],
        "additionalProperties": false,
        "properties": {
          "source_unit_id": { "type": "string", "minLength": 1 },
          "target_unit_id": { "type": "string", "minLength": 1 },
          "relation_label": {
            "type": "string",
            "enum": [
              "SUPPORTS",
              "ATTACKS",
              "RESPONDS_TO",
              "NO_RELATION"
            ]
          },
          "same_speaker": { "type": "boolean" },
          "cross_turn": { "type": "boolean" },
          "turn_distance": { "type": "integer", "minimum": 0 },
          "is_override": { "type": "boolean" },
          "annotator_id": { "type": "string", "minLength": 1 },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "note": { "type": "string" },
          "guideline_version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
