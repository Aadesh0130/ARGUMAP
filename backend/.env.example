# Database configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argumap

# CORS Allowed Origins (Comma-separated for local frontend development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server environment configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
