# Database configuration
# - For local development (SQLite):
# DATABASE_URL=sqlite:///./argumap_dev.db
#
# - For production on Render (PostgreSQL):
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
# (Legacy postgres:// and postgresql:// are automatically normalized to postgresql+psycopg2://)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/argumap

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (must include your deployed Vercel domain)
# Example for production: CORS_ORIGINS=https://argumap.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Regex pattern for dynamic preview domains (e.g., Vercel preview branches)
# CORS_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# Runtime environment (development | production)
APP_ENV=development

# Server host & port binding
# Set HOST to 0.0.0.0 for container / cloud hosting on Render
HOST=0.0.0.0
# PORT is automatically injected by Render (default: 8000 for local dev)
PORT=8000
LOG_LEVEL=info
